# Copy to `.env` at the repo root (read by apps/api).
# The frontend reads NEXT_PUBLIC_* variables from apps/web/.env.local.

# --- API (apps/api) ---
ROOTCAUSE_ENVIRONMENT=development
ROOTCAUSE_LOG_LEVEL=INFO
# JSON list of allowed browser origins.
ROOTCAUSE_CORS_ORIGINS=["http://localhost:3000"]
ROOTCAUSE_MAX_IMAGES=3
# Investigations per browser session, and per IP per hour (0 disables).
# ROOTCAUSE_INVESTIGATIONS_PER_SESSION=5
# ROOTCAUSE_INVESTIGATIONS_PER_IP_HOUR=60
ROOTCAUSE_MAX_IMAGE_BYTES=5242880

# --- AI analysis (server-side only; never expose to the browser) ---
# auto = Gemini first, Cerebras fallback, then the labelled mock if neither key is set.
ROOTCAUSE_ANALYSIS_PROVIDER=auto
# Priority key, plus an optional fallback key tried when calls on the first fail.
# (GEMINI_API_KEY is still accepted in place of GEMINI_API_KEY_PRIORITY.)
GEMINI_API_KEY_PRIORITY=
GEMINI_API_KEY_FALLBACK=
# ROOTCAUSE_GEMINI_MODEL=gemini-flash-latest
# ROOTCAUSE_GEMINI_RATE_LIMIT_FALLBACK_MODEL=gemini-3-flash-preview
CEREBRAS_API_KEY=
# ROOTCAUSE_CEREBRAS_MODEL=qwen-3.8-27b
# ROOTCAUSE_CEREBRAS_REASONING_EFFORT=low
# ROOTCAUSE_ANALYSIS_TIMEOUT_SECONDS=45

# --- Reference datasets and retrieval (DINOv2 + FAISS) ---
# Folder for raw datasets, embedding caches, model weights and indexes. Keep it outside Git and synced folders.
# ROOTCAUSE_DATA_DIR=/absolute/path/outside/the/repo
# Optional overrides (default to folders under ROOTCAUSE_DATA_DIR).
# ROOTCAUSE_EMBEDDING_MODEL_DIR=/path/to/models/dinov2-small/<revision>
# ROOTCAUSE_RETRIEVAL_INDEX_DIR=/path/to/artifacts/faiss/dinov2-small
# Index version to serve, e.g. v1. Versions are immutable once built.
# ROOTCAUSE_RETRIEVAL_INDEX_VERSION=v1

# --- Satellite evidence (Google Earth Engine, Sentinel-2) ---
# Earth Engine-registered Google Cloud project. Enables satellite evidence when set.
# Credentials are NOT configured here: locally use `gcloud auth application-default login`
# (or `earthengine authenticate`); in production attach a service account / workload identity.
# Never commit service-account JSON keys.
GOOGLE_CLOUD_PROJECT_ID=
# ROOTCAUSE_SATELLITE_ENABLED=true
# ROOTCAUSE_SATELLITE_WINDOW_DAYS=45
# ROOTCAUSE_SATELLITE_BUFFER_M=100
# ROOTCAUSE_SATELLITE_TIMEOUT_SECONDS=25
# ROOTCAUSE_SATELLITE_MIN_CLEAR_COVERAGE=0.6
# ROOTCAUSE_SATELLITE_STALE_DAYS=20
# ROOTCAUSE_SATELLITE_CACHE_TTL_SECONDS=21600

# --- Read-aloud of results (Gemini TTS, uses the Gemini keys above) ---
# ROOTCAUSE_TTS_ENABLED=true
# ROOTCAUSE_TTS_MODELS=["gemini-3.8-flash-lite-tts","gemini-3.8-flash-tts"]
# ROOTCAUSE_TTS_VOICE=Kore
# ROOTCAUSE_TTS_REQUESTS_PER_IP_HOUR=120

# --- After a triage: treatment guidance and nearby agri shops (Gemini + Google Maps grounding) ---
# ROOTCAUSE_ASSIST_ENABLED=true
# ROOTCAUSE_SHOP_SEARCH_MODELS=["gemini-flash-lite-latest","gemini-flash-latest"]
# ROOTCAUSE_ASSIST_REQUESTS_PER_IP_HOUR=120

# --- Voice input ---
# auto = Gemini (uses the Gemini keys above, detects English/Hindi), falling back to Speech-to-Text.
# ROOTCAUSE_SPEECH_PROVIDER=auto
# ROOTCAUSE_SPEECH_GEMINI_MODEL=gemini-flash-lite-latest
# Speech-to-Text V2 (Chirp 3) fallback: uses GOOGLE_CLOUD_PROJECT_ID unless overridden; the
# Speech-to-Text API must be enabled there.
# Credentials come from ADC (same as above); the caller needs roles/speech.client.
# ROOTCAUSE_SPEECH_ENABLED=true
# ROOTCAUSE_SPEECH_PROJECT_ID=
# Chirp 3 is available in the "us" and "eu" multi-regions.
# ROOTCAUSE_SPEECH_LOCATION=us
# ROOTCAUSE_SPEECH_MODEL=chirp_3
# JSON list. en-IN and hi-IN are GA; ta-IN, te-IN, mr-IN, bn-IN, gu-IN, kn-IN, ml-IN are Preview.
# ROOTCAUSE_SPEECH_LANGUAGES=["en-IN","hi-IN"]
# ROOTCAUSE_SPEECH_TIMEOUT_SECONDS=30
# ROOTCAUSE_MAX_AUDIO_BYTES=5242880

# --- Web (apps/web/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Evidence review: NVIDIA Nemotron on Nebius Token Factory (server-side only) ---
# Key from https://tokenfactory.nebius.com (API keys). Without it the review is reported as
# "not configured" and the first-stage triage is returned unchanged.
NEBIUS_API_KEY=
# ROOTCAUSE_NEBIUS_ENABLED=true
# ROOTCAUSE_NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# ROOTCAUSE_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# ROOTCAUSE_NEBIUS_TIMEOUT_SECONDS=30
# ROOTCAUSE_NEBIUS_MAX_RETRIES=1
# default | off | low | on. Use "default" if the endpoint rejects chat_template_kwargs.
# ROOTCAUSE_NEBIUS_REASONING=low
# ROOTCAUSE_NEBIUS_MAX_TOKENS=6000
# json_schema | json_object. Use json_object if the endpoint rejects json_schema for this model.
# ROOTCAUSE_NEBIUS_STRUCTURED_OUTPUT=json_schema
# Strict mode (hackathon/production): a missing or failed Nemotron review is shown as an error,
# never replaced by another model or a mock.
# ROOTCAUSE_HACKATHON_REQUIRE_LIVE_NEBIUS=false

# --- Agricultural guidance search: Tavily (server-side only) ---
# Key from https://app.tavily.com. Searches only the approved publisher allowlist in
# apps/api/app/services/knowledge/sources.py.
TAVILY_API_KEY=
# ROOTCAUSE_TAVILY_ENABLED=true
# ROOTCAUSE_TAVILY_TIMEOUT_SECONDS=12
# ROOTCAUSE_TAVILY_MAX_RESULTS=4
# ROOTCAUSE_TAVILY_CACHE_TTL_SECONDS=21600
# ROOTCAUSE_TAVILY_EXTRACT_ENABLED=true
# basic (1 credit) | advanced (2 credits)
# ROOTCAUSE_TAVILY_SEARCH_DEPTH=basic
# Optional JSON list that narrows (never widens) the built-in allowlist.
# ROOTCAUSE_TAVILY_ALLOWED_DOMAINS=["icar.org.in","tnau.ac.in","fao.org"]

# --- Investigation budget, follow-up questions and cost limits ---
# Total seconds for guidance search + Nemotron review after the first-stage triage.
# ROOTCAUSE_INVESTIGATION_TIMEOUT_SECONDS=55
# Reviews per day per API instance (bounds paid usage on public demos).
# ROOTCAUSE_INVESTIGATION_DAILY_LIMIT=300
# ROOTCAUSE_FOLLOW_UP_TTL_SECONDS=3600
# ROOTCAUSE_FOLLOW_UP_MAX_REPORTS=500
# Per-client hourly cap on the other model-backed endpoints (identify, translate, transcribe,
# follow-up); POST /triage uses the investigation limits at the top. In memory per instance.
# ROOTCAUSE_RATE_LIMIT_ENABLED=true
# ROOTCAUSE_RATE_LIMIT_PER_HOUR=60
# Proxies that append to X-Forwarded-For in front of the API (Cloud Run: 1; local: 0). Every
# per-IP limit reads the client address this way.
# ROOTCAUSE_TRUSTED_PROXY_HOPS=0